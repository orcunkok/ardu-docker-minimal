#!/bin/sh
#
# @name Holybro X500 V2 (SIH, SITL)
#
# @type Quadrotor
#
# PX4 SITL with built-in SIH physics, tuned to the Holybro X500 V2 (Pixhawk 6C).
# Physics: based on 10040_sihsim_quadx. Gains: copied from init.d/airframes/4019_x500_v2.
#

. ${R}etc/init.d/rc.mc_defaults

PX4_SIMULATOR=${PX4_SIMULATOR:=sihsim}
PX4_SIM_MODEL=${PX4_SIM_MODEL:=sihsim_x500}

param set-default SENS_EN_GPSSIM 1
param set-default SENS_EN_BAROSIM 1
param set-default SENS_EN_MAGSIM 1

# --- SIH physics: X500 V2 (500 mm wheelbase, ~2.0 kg take-off weight with 4S) ---
param set SIH_VEHICLE_TYPE 0
param set-default SIH_MASS 2.0
param set-default SIH_IXX 0.0217      # same inertia as PX4's gz x500 model
param set-default SIH_IYY 0.0217
param set-default SIH_IZZ 0.040
param set-default SIH_L_ROLL 0.177    # 0.25 m arm at 45 deg
param set-default SIH_L_PITCH 0.177
param set-default SIH_T_MAX 9.0       # N per motor (2216 920KV + 10x4.5 on 4S), hover ~55 %
param set-default SIH_Q_MAX 0.15      # Nm per motor
param set-default SIH_KDV 1.0
param set-default SIH_KDW 0.025
param set-default MPC_THR_HOVER 0.55

# --- Holybro X500 V2 gains (4019_x500_v2) ---
param set-default IMU_GYRO_CUTOFF 30
param set-default MC_ROLLRATE_P 0.14
param set-default MC_PITCHRATE_P 0.14
param set-default MC_ROLLRATE_I 0.3
param set-default MC_PITCHRATE_I 0.3
param set-default MC_ROLLRATE_D 0.004
param set-default MC_PITCHRATE_D 0.004

# Square quadrotor X, PX4 numbering (same as 4019_x500_v2)
param set-default CA_ROTOR_COUNT 4
param set-default CA_ROTOR0_PX 1
param set-default CA_ROTOR0_PY 1
param set-default CA_ROTOR1_PX -1
param set-default CA_ROTOR1_PY -1
param set-default CA_ROTOR2_PX 1
param set-default CA_ROTOR2_PY -1
param set-default CA_ROTOR2_KM -0.05
param set-default CA_ROTOR3_PX -1
param set-default CA_ROTOR3_PY 1
param set-default CA_ROTOR3_KM -0.05

param set-default PWM_MAIN_FUNC1 101
param set-default PWM_MAIN_FUNC2 102
param set-default PWM_MAIN_FUNC3 103
param set-default PWM_MAIN_FUNC4 104

param set-default EKF2_GPS_DELAY 0

# 4S 5000 mAh pack
param set-default BAT1_N_CELLS 4
param set-default BAT1_CAPACITY 5000

# MAVLink-only operation (GCS / OBC), no RC transmitter needed.
param set-default COM_RC_IN_MODE 4
param set-default NAV_DLL_ACT 0

# /params/extra/*.params (e.g. a QGC export of the real drone), generated by the entrypoint.
[ -f ./rc.extra ] && . ./rc.extra
